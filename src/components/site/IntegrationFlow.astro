---
import integrationFlowUrl from "../../scripts/integration-flow.js?url&no-inline";
---

<svg
  data-integration-flow
  aria-hidden="true"
  focusable="false"
  preserveAspectRatio="none"
>
  <defs>
    <filter id="integration-flow-glow" x="-60%" y="-60%" width="220%" height="220%">
      <feGaussianBlur stdDeviation="2.5" result="blur"></feGaussianBlur>
      <feMerge>
        <feMergeNode in="blur"></feMergeNode>
        <feMergeNode in="SourceGraphic"></feMergeNode>
      </feMerge>
    </filter>
  </defs>
  <g data-integration-lines></g>
</svg>

<script is:inline define:vars={{ integrationFlowUrl }}>
  const integrationStages = document.querySelectorAll("[data-integration-stage]");

  const initializeStage = async (stage) => {
    if (stage.dataset.flowInitialized) return;
    stage.dataset.flowInitialized = "pending";
    const { initializeIntegrationFlow } = await import(integrationFlowUrl);
    initializeIntegrationFlow(stage);
    stage.dataset.flowInitialized = "true";
  };

  if ("IntersectionObserver" in window) {
    const flowObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!(entry.target instanceof HTMLElement)) continue;
          entry.target.dataset.flowActive = String(entry.isIntersecting);
          if (entry.isIntersecting) void initializeStage(entry.target);
        }
      },
      { rootMargin: "300px 0px" },
    );

    for (const stage of integrationStages) flowObserver.observe(stage);
  } else {
    for (const stage of integrationStages) {
      if (!(stage instanceof HTMLElement)) continue;
      stage.dataset.flowActive = "true";
      void initializeStage(stage);
    }
  }
</script>

<style is:global>
  [data-integration-flow] {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  [data-integration-flow] path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  [data-integration-flow] .integration-flow__base {
    stroke: color-mix(in oklab, var(--cyan) 42%, transparent);
    stroke-width: 1;
    opacity: 0.3;
  }

  [data-integration-flow] .integration-flow__pulse {
    stroke: var(--signal);
    stroke-width: 2;
    stroke-dasharray: 0.14 0.86;
    stroke-dashoffset: 1;
    opacity: 0.9;
    filter: url("#integration-flow-glow");
    animation: integration-flow-pulse 3.4s linear infinite;
    animation-delay: calc(var(--flow-delay) * 160ms);
    animation-fill-mode: backwards;
    animation-play-state: paused;
  }

  [data-integration-stage][data-flow-active="true"] .integration-flow__pulse,
  [data-integration-stage][data-flow-active="true"] .animate-pulse {
    animation-play-state: running;
  }

  [data-integration-stage]:not([data-flow-active="true"]) .animate-pulse {
    animation-play-state: paused;
  }

  @keyframes integration-flow-pulse {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-integration-flow] .integration-flow__pulse {
      animation: none !important;
      opacity: 0;
    }
  }
</style>

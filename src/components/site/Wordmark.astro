---
import { Image } from "astro:assets";
import logo from "../../assets/dev-stream-labs-logo.png";

interface Props {
  class?: string;
  loading?: "eager" | "lazy";
}

const { class: className = "", loading = "lazy" } = Astro.props;
---

<a
  href="#top"
  class:list={["inline-flex items-center", className]}
  aria-label="Dev Stream Labs home"
>
  <Image
    src={logo}
    alt=""
    widths={[224, 396]}
    sizes="198px"
    format="webp"
    quality={90}
    {loading}
    class="h-12 w-auto"
    aria-hidden="true"
  />
</a>
